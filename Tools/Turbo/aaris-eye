#!/usr/bin/env bash
# AARIS AI Eyes & Hands V5 — compact, authenticated-Codespace-local command surface.
set -euo pipefail
HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PYTHON="${AARIS_PYTHON:-python3}"
export DISPLAY="${DISPLAY:-:99}"

usage() {
  cat <<'HELP'
AARIS AI Eyes & Hands V5
  aaris-eye hold X Y SECONDS [BUTTON]       Long press at any X11 pixel (default left button).
  aaris-eye click X Y                       Click screen pixel X,Y.
  aaris-eye drag X1 Y1 X2 Y2 SECONDS        Press, smoothly drag, release.
  aaris-eye snap [SECONDS] [FPS]            Capture actual desktop + evidence ZIP.
  aaris-eye scenario JSON                   Multi-step local actions + evidence ZIP.
  aaris-eye status                          Inspect Unity Editor state, when responsive.
  aaris-eye release                         Release named Unity game inputs.
  aaris-eye selftest                        Input validation tests.
Each action has a bounded duration, rejects unsafe coordinates and releases held
buttons even if the command is interrupted. X11 commands run only on this
Codespace's DISPLAY. No public listener is created.
HELP
}
number() { [[ "$1" =~ ^[0-9]{1,5}$ ]]; }
duration() { [[ "$1" =~ ^[0-9]{1,2}(\.[0-9]{1,3})?$ ]]; }
if (( $# == 0 )); then usage; exit 0; fi
OP="$1"; shift
case "$OP" in
  hold)
    if (( $# < 3 || $# > 4 )) || ! number "$1" || ! number "$2" || ! duration "$3"; then usage >&2; exit 2; fi
    button="${4:-1}"
    if [[ "$button" != 1 && "$button" != 2 && "$button" != 3 ]];then exit 2;fi
    exec "$PYTHON" "$HERE/eye_v5.py" --hold "$1" "$2" "$3" --button "$button" --fps 12
    ;;
  click)
    if (( $# != 2 )) || ! number "$1" || ! number "$2"; then usage >&2; exit 2; fi
    exec "$PYTHON" "$HERE/eye_v5.py" --script "[{\"op\":\"os_click\",\"x\":$1,\"y\":$2}]" --fps 12 --seconds 2
    ;;
  drag)
    if (( $# != 5 ));then usage >&2;exit 2;fi
    for x in "$1" "$2" "$3" "$4";do if ! number "$x";then exit 2;fi;done
    if ! duration "$5";then exit 2;fi
    exec "$PYTHON" "$HERE/eye_v5.py" --script "[{\"op\":\"os_drag\",\"x\":$1,\"y\":$2,\"to_x\":$3,\"to_y\":$4,\"seconds\":$5}]" --seconds 3 --fps 12
    ;;
  snap)
    if (( $# > 2 )); then usage >&2; exit 2; fi
    exec "$PYTHON" "$HERE/eye_v5.py" --script '[]' --seconds "${1:-2}" --fps "${2:-12}"
    ;;
  scenario)
    if (( $# != 1 ));then usage >&2;exit 2;fi
    exec "$PYTHON" "$HERE/eye_v5.py" --script "$1" --seconds 4 --fps 12
    ;;
  status|release)
    if (( $# != 0 ));then usage >&2;exit 2;fi
    cd -- "${AARIS_UNITY_PROJECT:-/workspaces/Unity-Game-Aris}"
    exec "$PYTHON" "$HERE/unity_v4.py" "$OP" --timeout 15
    ;;
  selftest)
    if (( $# != 0 ));then usage >&2;exit 2;fi
    "$PYTHON" "$HERE/gui_v4.py" --selftest
    "$PYTHON" "$HERE/unity_v4.py" --selftest
    "$PYTHON" "$HERE/eye_v5.py" --selftest
    ;;
  -h|--help|help)usage;;
  *)usage >&2;exit 2;;
esac
